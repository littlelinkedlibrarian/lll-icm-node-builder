NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/lll-node.sqlite
NODE_NAME=Happy Box
PUBLIC_BASE_URL=http://localhost:3000
OPERATOR_TOKEN=replace-with-a-long-random-value
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DISCOVERY_ENABLED=false
# Required only when DISCOVERY_ENABLED=true. The node key is a separate,
# single-purpose credential issued by Central; it is never a Central user token.
CENTRAL_BASE_URL=https://beta.littlelinkedlibrarian.com
CENTRAL_NODE_ID=lll-my-little-box
CENTRAL_NODE_API_KEY=
CENTRAL_HEARTBEAT_INTERVAL_SECONDS=300
MEDIA_DIRECTORY=./data/media
BIBLIOGRAPHIC_ENABLED=true
BIBLIOGRAPHIC_CONTACT=

# Production values for the approved tunnel (do not use these two lines for local-only startup):
# PUBLIC_BASE_URL=https://happybox.littlelinkedlibrarian.com
# HOST=0.0.0.0
