NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/lll-node.sqlite
NODE_NAME=Happy Box
PUBLIC_BASE_URL=http://localhost:3000
OPERATOR_TOKEN=replace-with-a-long-random-value
